// Copia de pruebas: rama "pruebas" → conecta-web-pruebas.conectaelretiroo.workers.dev.
// Se publica con `npx wrangler deploy -c wrangler.pruebas.jsonc` y no usa el dominio propio.
// Va en un archivo aparte para que la configuración de main quede igual a la que ya desplegaba bien.
{
  "name": "conecta-web-pruebas",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build" },
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
